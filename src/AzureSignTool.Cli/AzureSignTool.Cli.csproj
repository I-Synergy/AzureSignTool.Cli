<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>AzureSignTool.Cli</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>AzureSignTool</ToolCommandName>
    <AssemblyName>AzureSignTool</AssemblyName>
    <Description>AzureSignTool.Cli - sign files and NuGet packages with Azure Key Vault certificates</Description>
    <PackageTags>AzureSignTool, Cli, Azure, SignTool, CodeSigning, NuGet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Certificates" />
    <PackageReference Include="Azure.Security.KeyVault.Keys" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AzureSignTool.Core\AzureSignTool.Core.csproj" />
  </ItemGroup>
</Project>
